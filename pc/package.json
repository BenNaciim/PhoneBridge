{
  "name": "phonebridge-pc",
  "version": "0.2.0",
  "description": "Notifications et messages de votre téléphone Android sur le PC",
  "author": "PhoneBridge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "fake-phone": "node tools/fake-phone.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.phonebridge.pc",
    "productName": "PhoneBridge",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["main.js", "preload.js", "toast-preload.js", "renderer/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.png", "signExecutable": false },
    "nsis": { "artifactName": "PhoneBridge-Setup-${version}.${ext}", "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "shortcutName": "PhoneBridge" }
  }
}
